{
  "name": "atten-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode test",
    "dev:prod": "vite --mode prod",
    "build": "npm run build:test",
    "build:test": "tsc --noEmit && vite build --mode test",
    "build:prod": "tsc --noEmit && vite build --mode prod",
    "test": "node --test test/*.test.ts",
    "preview": "vite preview",
    "deploy": "npm run build:prod && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.2",
    "vite": "5.4.8",
    "wrangler": "4.140.0"
  }
}
