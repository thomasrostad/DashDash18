# Ett miljø per mappe, utenfor git: env/test/.env og env/prod/.env (kopier denne).
# Bare publishable key (aldri secret eller service_role). Bygget stopper hvis adressen og miljøet ikke stemmer.
VITE_SUPABASE_URL=https://<prosjekt>.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
# Valgfri. Site key for Cloudflare Turnstile (samme widget som appen). Tom: ingen CAPTCHA ved innlogging.
VITE_TURNSTILE_SITE_KEY=
